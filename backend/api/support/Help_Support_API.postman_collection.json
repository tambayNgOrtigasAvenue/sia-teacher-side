          "response": []
        },
        {
          "name": "Search Tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5173/api/support/search-tickets.php?keyword=login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5173",
              "path": ["api", "support", "search-tickets.php"],
              "query": [
                {
                  "key": "keyword",
                  "value": "login",
                  "description": "Search term to find in ticket subjects"
                }
              ]
            },
            "description": "Search tickets by keyword in subject"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Get Ticket Messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5173/api/support/get-ticket-messages.php?ticketId=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5173",
              "path": ["api", "support", "get-ticket-messages.php"],
              "query": [
                {
                  "key": "ticketId",
                  "value": "1",
                  "description": "The ID of the ticket"
                }
              ]
            },
            "description": "Get all messages (conversation thread) for a ticket"
          },
          "response": []
        },
        {
          "name": "Add Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": 1,\n  \"message\": \"I tried resetting my password again but still cannot login. Please help!\"\n}"
            },
            "url": {
              "raw": "http://localhost:5173/api/support/add-message.php",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5173",
              "path": ["api", "support", "add-message.php"]
            },
            "description": "Add a new message to an existing ticket"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5173",
      "type": "string"
    }
